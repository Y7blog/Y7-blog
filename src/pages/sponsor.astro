---
import Comment from "@components/comment/index.astro";
import { Icon } from "astro-icon/components";
import { commentConfig, siteConfig, sponsorConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

// 检查页面是否启用
if (!siteConfig.pages.sponsor) {
	return Astro.redirect("/404/");
}

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	sponsorConfig.showComment !== false;

const title = sponsorConfig.title || i18n(I18nKey.sponsorTitle);
const description =
	sponsorConfig.description || i18n(I18nKey.sponsorDescription);
const enabledMethods = sponsorConfig.methods.filter((method) => method.enabled);
const sponsors = sponsorConfig.sponsors || [];
const showSponsorsList = sponsorConfig.showSponsorsList !== false;

// LQIP 渐变占位
function getQrLqipProps(qrCode: string) {
	return getLqipProps(qrCode, undefined, true);
}
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-3">
            <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
                <Icon name="material-symbols:favorite" class="text-[1.5rem]"></Icon>
            </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        {description && (
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            {description}
          </p>
        )}
        {sponsorConfig.usage && (
          <div class="mb-8 p-4 rounded-lg bg-(--primary)/8 dark:bg-(--btn-regular-bg) border border-(--primary)/30 dark:border-none backdrop-blur-xs shadow-xs usage-info-box">
            <div class="flex items-start gap-2">
              <Icon name="material-symbols:info-outline" class="text-(--primary) text-lg shrink-0 mt-0.5" />
              <p class="text-sm text-neutral-700 dark:text-neutral-200 leading-relaxed">
                <span class="font-semibold text-(--primary)"></span>
                {sponsorConfig.usage}
              </p>
            </div>
          </div>
        )}
      </div>

      <!-- 打赏方式 -->
      <div class="mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    {enabledMethods.map((method) => (
                      <div class="flex flex-col items-center card-base p-6 rounded-lg bg-neutral-50 dark:bg-neutral-900/50 border border-neutral-200 dark:border-neutral-800 hover:border-(--primary) transition-colors">
                        <!-- 图标和名称 -->
                        <div class="flex items-center gap-3 mb-4">
                          {method.icon && (
                            <Icon name={method.icon} class="text-2xl text-neutral-900 dark:text-neutral-100 transition-colors" />
                          )}
                          <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">
                            {method.name}
                          </h3>
                        </div>

                        <!-- 描述 -->
                        {method.description && (
                          <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-4 text-center">
                            {method.description}
                          </p>
                        )}

                        <!-- 二维码或链接 -->
                        {method.qrCode && (
  <>
    <!-- 二维码缩略图 -->
    <div class="relative w-full max-w-[200px] aspect-square bg-white rounded-lg p-4 shadow-md mb-4 overflow-hidden">
      <div
        class="lqip-placeholder absolute inset-0 rounded-lg pointer-events-none"
        style={getQrLqipProps(method.qrCode).style}
        aria-hidden="true"
      ></div>

      <button
        type="button"
        class="relative block w-full h-full cursor-zoom-in p-0 border-0 bg-transparent"
        aria-label={`查看${method.name}二维码高清原图`}
        onclick={`openQrPreview('${url(method.qrCode)}')`}
      >
        <img
          src={url(method.qrCode)}
          alt={`${method.name} ${i18n(I18nKey.scanToSponsor)}`}
          class="relative w-full h-full object-contain opacity-0 transition-opacity duration-500 ease-out"
          loading="lazy"
        />
      </button>
    </div>

    <!-- 二维码高清预览弹窗 -->
    <div
      id="qr-preview-modal"
      class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/90 p-4"
      aria-hidden="true"
      onclick="closeQrPreview(event)"
    >
      <!-- 关闭按钮 -->
      <button
        type="button"
        class="absolute right-4 top-4 z-[10001] flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition hover:bg-white/20 active:bg-white/30"
        aria-label="关闭二维码预览"
        onclick="closeQrPreview()"
      >
        ×
      </button>

      <!-- 图片操作提示 -->
      <div
        class="pointer-events-none absolute bottom-5 left-1/2 z-[10000] -translate-x-1/2 whitespace-nowrap rounded-full bg-black/50 px-4 py-2 text-xs text-white/80"
      >
        手机双指缩放 · 电脑滚轮缩放 · 拖动查看
      </div>

      <!-- 图片容器 -->
      <div
        id="qr-preview-container"
        class="relative flex h-full w-full items-center justify-center overflow-hidden touch-none"
        onclick="event.stopPropagation()"
      >
        <img
          id="qr-preview-image"
          src=""
          alt="二维码高清原图"
          class="max-h-none max-w-none select-none object-contain will-change-transform"
          draggable="false"
        />
      </div>
    </div>
  </>
)}

<script is:inline>
  (() => {
    let qrScale = 1;
    let qrTranslateX = 0;
    let qrTranslateY = 0;

    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let startTranslateX = 0;
    let startTranslateY = 0;

    let initialDistance = 0;
    let initialScale = 1;

    const getModal = () => document.getElementById("qr-preview-modal");
    const getImage = () => document.getElementById("qr-preview-image");

    const updateQrTransform = () => {
      const image = getImage();

      if (!image) return;

      image.style.transform =
        `translate3d(${qrTranslateX}px, ${qrTranslateY}px, 0) scale(${qrScale})`;
    };

    const resetQrTransform = () => {
      qrScale = 1;
      qrTranslateX = 0;
      qrTranslateY = 0;

      updateQrTransform();
    };

    window.openQrPreview = (imageUrl) => {
      const modal = getModal();
      const image = getImage();

      if (!modal || !image) return;

      image.src = imageUrl;

      resetQrTransform();

      modal.classList.remove("hidden");
      modal.classList.add("flex");
      modal.setAttribute("aria-hidden", "false");

      document.body.style.overflow = "hidden";
    };

    window.closeQrPreview = (event) => {
      if (event && event.target !== event.currentTarget) {
        return;
      }

      const modal = getModal();

      if (!modal) return;

      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");

      document.body.style.overflow = "";

      resetQrTransform();
    };

    const container = document.getElementById("qr-preview-container");
    const image = document.getElementById("qr-preview-image");

    if (!container || !image) return;

    /*
     * PC：鼠标滚轮缩放
     */
    container.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();

        const zoomStep = 0.15;

        if (event.deltaY < 0) {
          qrScale += zoomStep;
        } else {
          qrScale -= zoomStep;
        }

        qrScale = Math.min(Math.max(qrScale, 0.5), 5);

        updateQrTransform();
      },
      { passive: false }
    );

    /*
     * PC：鼠标拖动
     */
    container.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch") return;

      isDragging = true;

      dragStartX = event.clientX;
      dragStartY = event.clientY;

      startTranslateX = qrTranslateX;
      startTranslateY = qrTranslateY;

      container.setPointerCapture(event.pointerId);
    });

    container.addEventListener("pointermove", (event) => {
      if (!isDragging || event.pointerType === "touch") return;

      qrTranslateX =
        startTranslateX + event.clientX - dragStartX;

      qrTranslateY =
        startTranslateY + event.clientY - dragStartY;

      updateQrTransform();
    });

    container.addEventListener("pointerup", () => {
      isDragging = false;
    });

    container.addEventListener("pointercancel", () => {
      isDragging = false;
    });

    /*
     * 手机：双指缩放
     */
    container.addEventListener(
      "touchstart",
      (event) => {
        if (event.touches.length !== 2) return;

        event.preventDefault();

        const dx =
          event.touches[0].clientX -
          event.touches[1].clientX;

        const dy =
          event.touches[0].clientY -
          event.touches[1].clientY;

        initialDistance = Math.sqrt(dx * dx + dy * dy);
        initialScale = qrScale;
      },
      { passive: false }
    );

    container.addEventListener(
      "touchmove",
      (event) => {
        if (event.touches.length !== 2) return;

        event.preventDefault();

        const dx =
          event.touches[0].clientX -
          event.touches[1].clientX;

        const dy =
          event.touches[0].clientY -
          event.touches[1].clientY;

        const currentDistance =
          Math.sqrt(dx * dx + dy * dy);

        if (!initialDistance) return;

        const scaleRatio =
          currentDistance / initialDistance;

        qrScale = initialScale * scaleRatio;

        qrScale = Math.min(Math.max(qrScale, 0.5), 5);

        updateQrTransform();
      },
      { passive: false }
    );

    /*
     * 手机：单指拖动
     */
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTranslateX = 0;
    let touchStartTranslateY = 0;

    container.addEventListener(
      "touchstart",
      (event) => {
        if (event.touches.length !== 1) return;

        touchStartX = event.touches[0].clientX;
        touchStartY = event.touches[0].clientY;

        touchStartTranslateX = qrTranslateX;
        touchStartTranslateY = qrTranslateY;
      },
      { passive: false }
    );

    container.addEventListener(
      "touchmove",
      (event) => {
        if (event.touches.length !== 1) return;

        event.preventDefault();

        const touch = event.touches[0];

        qrTranslateX =
          touchStartTranslateX +
          touch.clientX -
          touchStartX;

        qrTranslateY =
          touchStartTranslateY +
          touch.clientY -
          touchStartY;

        updateQrTransform();
      },
      { passive: false }
    );

    /*
     * ESC 关闭
     */
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        window.closeQrPreview();
      }
    });
  })();
</script>

                        {method.link && (
                          <a
                            href={method.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/90 active:scale-95 transition-all"
                          >
                            <span>{i18n(I18nKey.sponsorGoTo)}</span>
                            <Icon name="fa7-solid:arrow-up-right-from-square" class="text-sm" />
                          </a>
                        )}
                      </div>
                    ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 打赏者列表 -->
  {showSponsorsList && (
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mt-4">
      <div class="card-base z-10 px-9 py-6 relative w-full">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-lg bg-(--primary)/10 flex items-center justify-center">
              <Icon name="material-symbols:emoji-people-rounded" class="text-[1.25rem] text-(--primary)" />
            </div>
            <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
              {i18n(I18nKey.sponsorList)}
            </h2>
          </div>
          {sponsors.length > 0 && (
            <span class="text-xs text-neutral-400 dark:text-neutral-500">
              {sponsors.length}
            </span>
          )}
        </div>
        {sponsors.length > 0 ? (
          <div class="sponsor-grid">
            {sponsors.map((sponsor) => (
              <div class="group flex items-center gap-3 p-3 rounded-xl border border-(--line-divider) hover:border-(--primary) transition-all duration-200">
                {/* 头像占位 */}
                <!-- 新的头像逻辑：有头像用图片，没有用首字母 -->
                {sponsor.avatar ? (
                  <img 
                    src={url(sponsor.avatar)}
                    alt={sponsor.name}
                    class="w-9 h-9 rounded-full object-cover shrink-0"
                    loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                ) : null}

                <!-- 首字母头像（作为兜底，图片加载失败也会显示这个） -->
                <div 
                  class={`w-9 h-9 rounded-full bg-(--primary)/10 flex items-center justify-center shrink-0 group-hover:bg-(--primary)/20 transition-colors ${sponsor.avatar ? 'hidden' : ''}`}
                >
                  <span class="text-sm font-bold text-(--primary)">{sponsor.name.charAt(0)}</span>
                </div>

                {/* 信息 */}
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-sm text-neutral-900 dark:text-neutral-100 truncate">
                      {sponsor.name}
                    </span>
                    {sponsor.amount && (
                      <span class="shrink-0 text-xs font-bold text-(--primary)">
                        {sponsor.amount}
                      </span>
                    )}
                  </div>
                  {sponsor.date && (
                    <span class="text-[0.65rem] text-neutral-400 dark:text-neutral-500">
                      {new Date(sponsor.date).toLocaleDateString()}
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12 text-neutral-500 dark:text-neutral-500">
            <p>{i18n(I18nKey.sponsorEmpty)}</p>
          </div>
        )}
      </div>
    </div>
  )}
  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment customPath="/sponsor/" title="sponsor"  />
    </div>
  )}
</MainGridLayout>

<style>
  /* 透明模式下使用半透明背景 */
  :global(body.wallpaper-transparent .usage-info-box) {
    background-color: rgba(var(--primary-rgb, 70, 130, 180), 0.15) !important;
  }

  :global(:root.dark body.wallpaper-transparent .usage-info-box) {
    background-color: oklch(from var(--primary) l c h / 0.15) !important;
  }
</style>

<style is:global>
  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }
</style>

