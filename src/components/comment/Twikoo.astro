---
import { commentConfig } from "@/config/commentConfig";
import { url } from "@/utils/url-utils";

interface Props {
	path: string;
}

const twikooConfig = commentConfig.twikoo ?? { envId: "" };
const jsUrl =
	twikooConfig.jsUrl ||
	"https://registry.npmmirror.com/twikoo/1.7.13/files/dist/twikoo.min.js";
const cssUrl = twikooConfig.cssUrl;
const config = {
	...twikooConfig,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<div id="tcomment"></div>
<script is:inline src={jsUrl} defer></script>
{cssUrl && <link rel="stylesheet" href={cssUrl.startsWith("http") ? cssUrl : url(cssUrl)} />}
<script is:inline define:vars={{ config }}>
  // 获取当前页面路径
  function getCurrentPath() {
    const requestedPath = new URLSearchParams(window.location.search).get("path");
    if (requestedPath) return requestedPath;
    const pathname = window.location.pathname;
    return pathname.endsWith("/") && pathname.length > 1
      ? pathname.slice(0, -1)
      : pathname;
  }

  // 动态创建配置对象
  function createTwikooConfig() {
    return {
      ...config,
      path: getCurrentPath(),
      el: "#tcomment",
    };
  }

  // 聊天式时间正序：评论渲染完成后自动切换到「最早」排序（从上到下按时间排列）
  function applyChatSortOrder() {
    var attempts = 0;
    var timer = setInterval(function () {
      attempts += 1;
      var sortBar = document.querySelector(".tk-comments-sort");
      if (sortBar) {
        clearInterval(timer);
        var oldestBtn = sortBar.querySelector(".tk-sort-item:nth-child(2)");
        if (oldestBtn && !oldestBtn.classList.contains("__active")) {
          oldestBtn.click();
        }
        return;
      }
      if (attempts >= 20) clearInterval(timer);
    }, 300);
  }

  // 绝对时间格式：YYYY/MM/DD HH:mm（同参考留言板，含年份）
  function gbFormatTime(dt) {
    var d = new Date(dt);
    if (isNaN(d.getTime())) return null;
    var p = function (n) { return String(n).padStart(2, "0"); };
    return d.getFullYear() + "/" + p(d.getMonth() + 1) + "/" + p(d.getDate()) + " " + p(d.getHours()) + ":" + p(d.getMinutes());
  }

  // DiceBear 头像风格（commentConfig.dicebearStyle）
  var diceStyle = (config.dicebearStyle || "adventurer").replace(/[^a-z-]/gi, "");

  // 输入框头像实时预览：按当前输入的邮箱计算 DiceBear 头像
  // （sha256(邮箱) 与 Twikoo 的哈希一致 → 预览即发布后效果；QQ 邮箱预览 QQ 头像）
  var gbAvatarTimer = 0;
  var gbFormAvatarObs = null;
  var gbFormAvatarLock = false;
  function gbSetFormPreview(img, url, title) {
    if (title) img.title = title;
    if (img.dataset.gbPreview === url && img.getAttribute("src") === url) return;
    img.dataset.gbPreview = url;
    gbFormAvatarLock = true;
    img.setAttribute("src", url);
    gbFormAvatarLock = false;
    if (gbFormAvatarObs && gbFormAvatarObs._img !== img) {
      gbFormAvatarObs.disconnect(); gbFormAvatarObs = null;
    }
    if (!gbFormAvatarObs) {
      var obs = new MutationObserver(function () {
        if (gbFormAvatarLock) return;
        var want = img.dataset.gbPreview;
        if (want && img.getAttribute("src") !== want) {
          gbFormAvatarLock = true;
          img.setAttribute("src", want);
          gbFormAvatarLock = false;
        }
      });
      obs._img = img;
      obs.observe(img, { attributes: true, attributeFilter: ["src"] });
      gbFormAvatarObs = obs;
    }
  }
  function gbSimpleHash(str) {
    var hash = 0;
    for (var i = 0; i < str.length; i++) {
      hash = ((hash << 5) - hash + str.charCodeAt(i)) | 0;
    }
    return Math.abs(hash).toString(16).padStart(8, "0");
  }
  function gbExtractHash(src) {
    var m = src.match(/\/(?:avatar|seed)[\/=]?([0-9a-f]{8,64})/i);
    return m ? m[1] : null;
  }
  function gbDiceBearUrl(seed) {
    return "https://api.dicebear.com/9.x/" + diceStyle + "/svg?seed=" + seed;
  }
  function gbRewriteFormAvatar() {
    var img = document.querySelector(".tk-submit .tk-avatar-img");
    var mailInput = document.querySelector(".tk-submit input[name='mail']");
    if (!img || !mailInput) return;
    img.title = "头像随邮箱自动生成";
    var mail = String(mailInput.value || "").trim().toLowerCase();
    if (!mail) return;
    var qq = mail.match(/^(\d{5,12})@qq\.com$/i);
    if (qq) {
      gbSetFormPreview(img, "https://q1.qlogo.cn/g?b=qq&nk=" + qq[1] + "&s=100");
      return;
    }
    var adminEmail = (config.adminEmail || "").trim().toLowerCase();
    var adminAvatar = (config.adminAvatar || "").trim();
    if (adminEmail && mail === adminEmail && adminAvatar) {
      gbSetFormPreview(img, adminAvatar);
      return;
    }
    var backendUrl = gbGetBackendAvatar(mail);
    if (backendUrl) {
      var hash = gbExtractHash(backendUrl);
      gbSetFormPreview(img, hash ? gbDiceBearUrl(hash) : backendUrl, "点击头像随机更换");
      return;
    }
    var storedUrl = "";
    try { storedUrl = localStorage.getItem("gb-avatar-url") || ""; } catch (e) {}
    if (storedUrl) {
      gbSetFormPreview(img, storedUrl, "点击头像随机更换");
      return;
    }
    var setDiceBear = function (hash) {
      gbSetFormPreview(img, gbDiceBearUrl(hash), "点击头像随机更换");
    };
    if (window.crypto && window.crypto.subtle) {
      crypto.subtle
        .digest("SHA-256", new TextEncoder().encode(mail))
        .then(function (buf) {
          var hash = Array.from(new Uint8Array(buf)).map(function (b) { return b.toString(16).padStart(2, "0"); }).join("");
          setDiceBear(hash);
        })
        .catch(function () { setDiceBear(gbSimpleHash(mail)); });
    } else {
      setDiceBear(gbSimpleHash(mail));
    }
  }
  function gbScheduleFormAvatar() {
    clearTimeout(gbAvatarTimer);
    gbAvatarTimer = setTimeout(gbRewriteFormAvatar, 250);
  }

  // 获取某邮箱在后端绑定的头像（发送评论后自动缓存）
  function gbGetBackendAvatar(mail) {
    try { return localStorage.getItem("gb-avatar-email:" + mail) || ""; } catch (e) { return ""; }
  }

  // 发送评论后捕获后端返回的头像，按邮箱存入 localStorage
  function gbCapturePostSubmitAvatar() {
    var sendBtn = document.querySelector(".tk-submit .tk-send");
    if (!sendBtn || sendBtn.dataset.gbCapture) return;
    sendBtn.dataset.gbCapture = "1";
    sendBtn.addEventListener("click", function () {
      var mailInput = document.querySelector(".tk-submit input[name='mail']");
      if (!mailInput) return;
      var mail = String(mailInput.value || "").trim().toLowerCase();
      if (!mail) return;
      var container = document.querySelector(".tk-comments-container");
      if (!container) return;
      var existing = container.querySelectorAll(".tk-comment");
      var existingSet = new Set();
      existing.forEach(function (c) { existingSet.add(c); });
      var tries = 0;
      var observer = new MutationObserver(function () {
        tries++;
        var all = container.querySelectorAll(".tk-comment");
        var found = null;
        all.forEach(function (c) { if (!existingSet.has(c)) found = c; });
        if (!found && tries > 30) { observer.disconnect(); return; }
        if (!found) return;
        observer.disconnect();
        var newImg = found.querySelector(".tk-avatar-img");
        if (!newImg) return;
        var src = newImg.getAttribute("src") || "";
        if (src) {
          var storedSrc = src;
          var wm = src.match(/\/avatar\/([0-9a-f]{16,64})/i);
          if (wm && src.indexOf("dicebear") === -1) {
            storedSrc = "https://api.dicebear.com/9.x/" + diceStyle + "/svg?seed=" + wm[1];
          }
          try { localStorage.setItem("gb-avatar-email:" + mail, storedSrc); } catch (e) {}
          gbRewriteFormAvatar();
        }
      });
      observer.observe(container, { childList: true, subtree: true });
      setTimeout(function () { observer.disconnect(); }, 10000);
    });
  }

  // 评论增强：绝对时间、复制消息按钮、输入框头像预览（幂等，可重复执行）
  function applyChatEnhancements() {
    var container = document.querySelector(".tk-comments-container");
    if (!container) return;

    // 输入框头像实时预览
    gbRewriteFormAvatar();
    gbCapturePostSubmitAvatar();

    // 0) 内联评论数：同步到「评论区」标题旁（文章/动态页）
    var inline = document.querySelector("[data-inline-count]");
    var countEl = document.querySelector(".tk-comments-count");
    if (inline && countEl) {
      var cm = countEl.textContent.replace(/\s+/g, "").match(/(\d+)/);
      if (cm) inline.textContent = cm[1] + " 条评论";
    }

    // 1) 相对时间 → 绝对时间（MM/DD HH:mm）
    container.querySelectorAll(".tk-time time").forEach(function (t) {
      if (t.dataset.gbTime) return;
      t.dataset.gbTime = "1";
      var dt = t.getAttribute("datetime");
      var text = dt ? gbFormatTime(dt) : null;
      if (text) t.textContent = text;
    });

    // 2) 复制消息按钮：追加到操作按钮行
    container.querySelectorAll(".tk-comment > .tk-main > .tk-row .tk-action").forEach(function (act) {
      if (act.dataset.gbCopy) return;
      act.dataset.gbCopy = "1";
      var comment = act.closest(".tk-comment");
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "tk-action-link gb-copy-btn";
      btn.title = "复制消息";
      btn.setAttribute("aria-label", "复制消息");
      btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';
      btn.addEventListener("click", function () {
        var text = comment ? (comment.querySelector(".tk-content") || {}).textContent || "" : "";
        if (navigator.clipboard && text.trim()) {
          navigator.clipboard.writeText(text.trim());
          btn.classList.add("gb-copied");
          setTimeout(function () { btn.classList.remove("gb-copied"); }, 800);
        }
      });
      act.appendChild(btn);
    });

    // 5) 头像：管理员（带博主徽章）用专属头像；游客用 DiceBear 按邮箱哈希生成
    // （同一邮箱哈希恒定同一头像，不同邮箱各不相同；QQ 原生头像保留）
    var adminAvatar = (config.adminAvatar || "").trim();
    container.querySelectorAll(".tk-comment").forEach(function (c) {
      var img = c.querySelector(".tk-avatar-img");
      if (!img) return;
      var isMaster = !!c.querySelector(".tk-tag-green");
      if (isMaster && adminAvatar) {
        if (img.dataset.gbAvatar !== "admin") {
          img.dataset.gbAvatar = "admin";
          img.setAttribute("src", adminAvatar);
        }
        return;
      }
      if (img.dataset.gbAvatar) return; // 已处理（含 QQ 原生头像保留）
      var src = img.getAttribute("src") || "";
      if (!src || src.indexOf("qlogo.cn") !== -1) return;
      if (src.indexOf("dicebear") !== -1) { img.dataset.gbAvatar = "dice"; return; }
      var m = src.match(/\/avatar\/([0-9a-f]{16,64})/i);
      if (!m) return; // 哈希结构不匹配则不处理
      img.dataset.gbAvatar = "dice";
      img.setAttribute("src", "https://api.dicebear.com/9.x/" + diceStyle + "/svg?seed=" + m[1]);
    });

    // 4) 刷新/设置代理按钮：放到信息填写框右上角（原按钮行整体隐藏，点击代理到最新原节点）
    document.querySelectorAll(".tk-submit").forEach(function (submit) {
      var icons = document.querySelectorAll(".tk-comments-title .tk-comments-actions .tk-icon.__comments");
      if (!icons.length) return;
      var tools = submit.querySelector(".gb-form-tools");
      if (!tools) {
        var col = submit.querySelector(".tk-col");
        if (!col) return;
        tools = document.createElement("div");
        tools.className = "gb-form-tools";
        col.insertBefore(tools, col.firstChild);
      }
      [0, 1].forEach(function (idx) {
        var orig = icons[idx];
        if (!orig) return;
        var proxy = tools.children[idx];
        if (!proxy) {
          proxy = document.createElement("button");
          proxy.type = "button";
          proxy.className = "gb-form-tool";
          var label = idx === 0 ? "刷新评论" : "评论设置";
          proxy.title = label;
          proxy.setAttribute("aria-label", label);
          proxy.addEventListener("click", function () {
            var now = document.querySelectorAll(".tk-comments-title .tk-comments-actions .tk-icon.__comments");
            if (now[idx]) now[idx].dispatchEvent(new MouseEvent("click", { bubbles: true }));
          });
          tools.appendChild(proxy);
        }
        if (proxy.innerHTML !== orig.innerHTML) proxy.innerHTML = orig.innerHTML;
        proxy.style.display = orig.style.display === "none" ? "none" : "";
      });
    });
  }

  // 监听评论列表变化（排序切换/加载更多/新评论），自动重跑增强
  function watchChatEnhancements() {
    var container = document.querySelector(".tk-comments-container");
    if (!container || container.dataset.gbWatch) return;
    container.dataset.gbWatch = "1";
    var scheduled = 0;
    var observer = new MutationObserver(function () {
      if (scheduled) return;
      scheduled = setTimeout(function () {
        scheduled = 0;
        applyChatEnhancements();
      }, 200);
    });
    observer.observe(container, { childList: true, subtree: true });
  }

  // 输入框头像实时预览：监听邮箱输入与失焦（window 守卫防止重复注册）
  if (!window.__gbFormAvatarLive) {
    window.__gbFormAvatarLive = true;
    document.addEventListener("input", function (e) {
      var t = e.target;
      if (t && t.name === "mail" && t.closest && t.closest(".tk-submit")) {
        gbScheduleFormAvatar();
      }
    });
    document.addEventListener("change", function (e) {
      var t = e.target;
      if (t && t.name === "mail" && t.closest && t.closest(".tk-submit")) {
        // 失焦时 Twikoo 会重设头像地址，之后再改写为预览头像
        try { localStorage.removeItem("gb-avatar-url"); } catch (e) {}
        setTimeout(gbRewriteFormAvatar, 120);
      }
    });
    document.addEventListener("click", function (e) {
      var t = e.target;
      if (!t || !t.closest || !t.closest(".tk-submit .tk-avatar-img")) return;
      var img = t.closest(".tk-submit .tk-avatar-img");
      var mailInput = document.querySelector(".tk-submit input[name='mail']");
      if (!mailInput) return;
      var mail = String(mailInput.value || "").trim().toLowerCase();
      if (!mail) return;
      if (/^\d{5,12}@qq\.com$/i.test(mail)) return;
      var adminEmail = (config.adminEmail || "").trim().toLowerCase();
      if (adminEmail && mail === adminEmail) return;
      if (gbGetBackendAvatar(mail)) return;
      var randomSeed = "r_" + Date.now() + "_" + Math.random().toString(36).slice(2, 8);
      var randomUrl = "https://api.dicebear.com/9.x/" + diceStyle + "/svg?seed=" + randomSeed;
      try { localStorage.setItem("gb-avatar-url", randomUrl); } catch (e) {}
      gbSetFormPreview(img, randomUrl, "点击头像随机更换");
    });
  }

  // 初始化 Twikoo
  function initTwikoo() {
    if (typeof twikoo !== "undefined") {
      const commentEl = document.getElementById("tcomment");
      if (commentEl) {
        commentEl.innerHTML = "";

        const dynamicConfig = createTwikooConfig();
        console.log("[Twikoo] Init config:", dynamicConfig);

        twikoo
          .init(dynamicConfig)
          .then(() => {
            console.log("[Twikoo] Init complete");
            applyChatSortOrder();
            applyChatEnhancements();
            watchChatEnhancements();
          })
          .catch((error) => {
            console.error("[Twikoo] Init failed:", error);
          });
      }
    } else {
      // 如果 Twikoo 未加载，稍后重试
      setTimeout(initTwikoo, 500);
    }
  }

  // 页面加载时初始化
  document.addEventListener("DOMContentLoaded", initTwikoo);

  // Swup 页面切换后重新初始化
  if (window.swup && window.swup.hooks) {
    window.swup.hooks.on("content:replace", function () {
      setTimeout(initTwikoo, 200);
    });
  } else {
    document.addEventListener("swup:enable", function () {
      if (window.swup && window.swup.hooks) {
        window.swup.hooks.on("content:replace", function () {
          setTimeout(initTwikoo, 200);
        });
      }
    });
  }

  // 自定义事件监听
  document.addEventListener("firefly:page:loaded", function () {
    const commentEl = document.getElementById("tcomment");
    if (commentEl) {
      console.log("[Twikoo] Re-initializing via custom event");
      initTwikoo();
    }
  });
</script>
