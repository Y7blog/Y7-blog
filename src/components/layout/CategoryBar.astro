---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const totalPosts = (await getSortedPostsList()).length;
const homeUrl = url("/");
const archiveUrl = url("/archive/");

// 服务端计算初始高亮 pill（首屏无需等 JS）。
// 查询串筛选（?category=/?tag=/?uncategorized）在静态页构建期不可知，
// 交由客户端脚本在加载/导航时同步；此处只处理路径可确定的情况。
const pathname = Astro.url.pathname.replace(/\/$/, "");
const homePath = homeUrl.replace(/\/$/, "");
const archivePath = archiveUrl.replace(/\/$/, "");
const isHome = pathname === homePath || pathname === "" || pathname === "/";
const isArchive = pathname === archivePath;

function initialActive(categoryName: string): { active?: boolean } {
	if (isHome) return categoryName === "" ? { active: true } : {};
	if (isArchive) return categoryName === "__archive__" ? { active: true } : {};
	if (pathname === "/categories")
		return categoryName === "__categories__" ? { active: true } : {};
	if (pathname === "/tags")
		return categoryName === "__tags__" ? { active: true } : {};
	if (pathname === "/series")
		return categoryName === "__series__" ? { active: true } : {};
	return {};
}
---

<div
  class="card-base category-bar p-3 onload-animation"
  id="category-bar"
  data-home-path={homeUrl}
  data-archive-path={archiveUrl}
>
  <div class="category-bar-inner flex gap-2">
    <a
      href={homeUrl}
      class="category-pill focus-ring-inset text-sm px-3 py-1.5 shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name=""
      data-active={initialActive("").active ? "" : undefined}
      aria-label={i18n(I18nKey.home)}
    >
      <Icon name="material-symbols:home" class="text-lg" />
    </a>
    <a
      href={archiveUrl}
      class="category-pill focus-ring-inset text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__archive__"
      data-active={initialActive("__archive__").active ? "" : undefined}
    >
      {/* 导航栏「金库」栏目下的文章入口，自定义文案不用 i18n */}
      文章
      <span class="pill-count">{totalPosts}</span>
    </a>
    <div class="category-divider shrink-0"></div>
    <a
      href={url("/categories/")}
      class="category-pill focus-ring-inset text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__categories__"
      data-active={initialActive("__categories__").active ? "" : undefined}
    >
      {i18n(I18nKey.categories)}
    </a>
    <a
      href={url("/series/")}
      class="category-pill focus-ring-inset text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__series__"
      data-active={initialActive("__series__").active ? "" : undefined}
    >
      {i18n(I18nKey.series)}
    </a>
    <a
      href={url("/tags/")}
      class="category-pill focus-ring-inset text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__tags__"
      data-active={initialActive("__tags__").active ? "" : undefined}
    >
      {i18n(I18nKey.tags)}
    </a>
  </div>
</div>

<style>
  .category-bar .category-pill {
    border: none;
  }
  .category-bar {
    margin-bottom: 1rem;
  }
  .category-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
    opacity: 0.5;
  }
</style>

<script>
  function setActiveCategory(bar: HTMLElement, currentUrl: URL) {
    const pathname = currentUrl.pathname.replace(/\/$/, "");
    const homePath = (bar.getAttribute("data-home-path") || "/").replace(/\/$/, "");
    const archivePath = (bar.getAttribute("data-archive-path") || "/archive").replace(/\/$/, "");
    const isHome = pathname === homePath || pathname === "" || pathname === "/";
    const isArchive = pathname === archivePath;
    const isCategories = pathname === "/categories";
    const isTags = pathname === "/tags";
    const isSeries = pathname === "/series";

    const activeName = isHome
      ? ""
      : isArchive
        ? "__archive__"
        : isCategories
          ? "__categories__"
          : isTags
            ? "__tags__"
            : isSeries
              ? "__series__"
              : null;

    const pills = bar.querySelectorAll<HTMLAnchorElement>(".category-pill");
    pills.forEach((pill) => pill.removeAttribute("data-active"));

    if (activeName === null) return;
    bar
      .querySelector<HTMLAnchorElement>(`.category-pill[data-category-name="${activeName}"]`)
      ?.setAttribute("data-active", "");
  }

  function updateCategoryBar(currentUrl = new URL(window.location.href)) {
    const bar = document.getElementById("category-bar");
    if (!bar) return;
    setActiveCategory(bar, currentUrl);
  }

  updateCategoryBar();
  // 防止 Swup 切页重跑脚本时重复注册监听器/hooks
  if (!window.__categoryBarInit) {
    window.__categoryBarInit = true;
    document.addEventListener("astro:page-load", () => {
      updateCategoryBar();
    });
    document.addEventListener("swup:contentReplaced", () => {
      updateCategoryBar();
      // 某些 swup 生命周期下 URL/DOM 状态同步稍晚，下一帧再校正一次避免状态残留
      requestAnimationFrame(() => {
        updateCategoryBar();
      });
    });

    if (window.swup?.hooks) {
      setupSwupEarlyUpdate();
    } else {
      document.addEventListener("swup:enable", setupSwupEarlyUpdate);
    }
  }

  // 在 Swup 导航时提前更新状态，避免切换期间激活态闪烁
  function setupSwupEarlyUpdate() {
    if (!window.swup?.hooks) return;
    window.swup.hooks.on("visit:start", (visit: any) => {
      const bar = document.getElementById("category-bar");
      if (!bar) return;
      setActiveCategory(bar, new URL(visit.to.url, window.location.href));
    });
  }
</script>
