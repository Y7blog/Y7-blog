{
	"name": "firefly",
	// 不能超过本地 workerd 二进制支持的日期（当前为 2026-09-04），
	// 否则 astro dev 的本地 Workers 运行时无法启动；线上无此限制
	"compatibility_date": "2026-09-04",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist"
	},
	// 用 Worker Route 接管现有域名解析（记录仍指向 GitHub Pages 也没关系，
	// 路由优先于回源；无需删除/修改 DNS 记录）。
	// 注意：zone 是以子域名形式加进 Cloudflare 的，zone_name 必须写 y7ai.ccwu.cc 全称
	"routes": [
		{
			"pattern": "y7ai.ccwu.cc/*",
			"zone_name": "y7ai.ccwu.cc"
		}
	],
	"kv_namespaces": [
		{
			"binding": "Y7BLOG_KV",
			"id": "6200959951c44786a050133b6fe6ab13"
		}
	]
}
