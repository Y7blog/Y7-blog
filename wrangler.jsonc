{
	"name": "firefly",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist"
	},
	// 用 Worker Route 接管现有域名解析（记录仍指向 GitHub Pages 也没关系，
	// 路由优先于回源；无需删除/修改 DNS 记录）
	"routes": [
		{
			"pattern": "y7ai.ccwu.cc/*",
			"zone_name": "ccwu.cc"
		}
	],
	"kv_namespaces": [
		{
			"binding": "Y7BLOG_KV",
			"id": "6200959951c44786a050133b6fe6ab13"
		}
	]
}
